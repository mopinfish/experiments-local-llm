   "source": [
    "from datetime import datetime\n\ntimestamp = datetime.now().strftime(\"%Y%m%d_%H%M%S\")\n\n# numpy型をPython標準型に変換\ndef convert_to_serializable(obj):\n    if isinstance(obj, (np.integer,)):\n        return int(obj)\n    elif isinstance(obj, (np.floating,)):\n        return float(obj)\n    elif isinstance(obj, np.ndarray):\n        return obj.tolist()\n    elif isinstance(obj, dict):\n        return {k: convert_to_serializable(v) for k, v in obj.items()}\n    elif isinstance(obj, list):\n        return [convert_to_serializable(i) for i in obj]\n    return obj\n\n# JSON結果保存\nresults_data = {\n    \"experiment\": \"phase9c_step2\",\n    \"description\": \"Model upgrade evaluation (C1 vs C2: Qwen2.5-7B -> Qwen3-32B)\",\n    \"timestamp\": timestamp,\n    \"test_count\": len(full_results[\"hybrid_rag\"]),\n    \"model\": model_id,\n    \"model_c1\": \"Qwen2.5-7B-Instruct 4bit\",\n    \"model_c2\": model_id,\n    \"prompt_version\": \"C1 (improved: same as Step 1)\",\n    \"enable_thinking\": False,\n    \"systems\": {}\n}\n\nfor sys_name, results in full_results.items():\n    summary = evaluator.generate_summary(results)\n    results_data[\"systems\"][sys_name] = {\n        \"summary\": convert_to_serializable(summary),\n        \"results\": [convert_to_serializable(r.to_dict()) for r in results]\n    }\n\n# C1ベースライン情報も含める\nif c1_overall:\n    results_data[\"baseline_c1\"] = convert_to_serializable({\n        \"source\": c1_file if 'c1_file' in dir() else \"N/A\",\n        \"summary\": c1_summary\n    })\n\noutput_file = f\"{PROJECT_PATH}/results/phase9c_step2_{timestamp}.json\"\nwith open(output_file, 'w', encoding='utf-8') as f:\n    json.dump(results_data, f, ensure_ascii=False, indent=2)\nprint(f\"Results saved to {output_file}\")\n\n# テキストサマリー保存\nsummary_file = f\"{PROJECT_PATH}/results/phase9c_step2_summary_{timestamp}.txt\"\nwith open(summary_file, 'w', encoding='utf-8') as f:\n    f.write(\"Phase 9-C Step 2: Model Upgrade Evaluation Summary\\n\")\n    f.write(\"=\" * 60 + \"\\n\\n\")\n    f.write(f\"Date: {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}\\n\")\n    f.write(f\"Test Cases: {results_data['test_count']}\\n\")\n    f.write(f\"Model C1: {results_data['model_c1']}\\n\")\n    f.write(f\"Model C2: {results_data['model_c2']}\\n\")\n    f.write(f\"Prompt: {results_data['prompt_version']}\\n\")\n    f.write(f\"enable_thinking: {results_data['enable_thinking']}\\n\\n\")\n\n    f.write(\"C1 vs C2 Comparison (Hybrid RAG):\\n\")\n    f.write(\"-\" * 60 + \"\\n\")\n    if c1_overall:\n        for key, label in [(\"avg_composite_score\", \"Composite\"), (\"avg_reasoning_score\", \"Reasoning\"),\n                           (\"avg_evidence_score\", \"Evidence\"), (\"composite_success_rate\", \"CompSuccess%\")]:\n            v1 = c1_overall.get(key, 0)\n            v2 = c2_overall.get(key, 0)\n            mult = 100 if \"rate\" in key else 1\n            f.write(f\"  {label}: C1={v1*mult:.1f} -> C2={v2*mult:.1f} (delta={((v2-v1)*mult):+.1f})\\n\")\n\n    f.write(f\"\\nC2 Target Achievement:\\n\")\n    f.write(\"-\" * 60 + \"\\n\")\n    for key, label, target, multiplier in [\n        (\"avg_composite_score\", \"Composite\", 70.0, 1),\n        (\"avg_reasoning_score\", \"Reasoning\", 3.0, 1),\n        (\"avg_evidence_score\", \"Evidence\", 3.5, 1),\n        (\"composite_success_rate\", \"Success%\", 0.80, 100),\n    ]:\n        value = c2_overall.get(key, 0)\n        met = value >= target\n        f.write(f\"  {label}: {value*multiplier:.1f} / {target*multiplier:.1f} {'PASS' if met else 'MISS'}\\n\")\n\nprint(f\"Summary saved to {summary_file}\")\nprint(\"\\nEvaluation complete!\")"
   ]
